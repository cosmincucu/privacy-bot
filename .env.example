# Generate long random values locally; never commit the real .env.
APP_REVISION=replace-with-source-commit
# Empty values generate protected access-token and encryption.key files on first start.
# To keep the key outside the data mount, supply a Fernet key before first startup.
PRIVACY_BOT_TOKEN=
PRIVACY_BOT_KEY=
BIND_ADDRESS=127.0.0.1
DATA_PATH=./data
ROOT_PATH=
PUBLIC_URL=http://localhost:8791/
PRIVACY_BOT_ACCESS=token
# Optional existing local search service. Queries include your name and a broker domain.
# DONSETCH_URL=http://trusted-search-service:8765/mcp
# DONSETCH_TOKEN=operator-managed-service-token
# Optional trusted-network mode requires HTTPS and explicit network/proxy allowlists.
# No access token is needed in this mode. Never trust an arbitrary forwarded header.
# PRIVACY_BOT_ACCESS=network
# PRIVACY_BOT_ALLOWED_NETWORKS=192.168.50.0/24
# PRIVACY_BOT_TRUSTED_PROXIES=172.30.0.2/32
# PUBLIC_URL=https://privacy.example.com/
# PROXY_NETWORK=reverse-proxy
# PROXY_NETWORK_EXTERNAL=true
